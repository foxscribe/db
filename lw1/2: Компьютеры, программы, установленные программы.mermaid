flowchart TD
    %% === Сущности ===
    E_Proizv[Производитель]
    E_PK[Компьютер]
    E_Pol[Пользователь]
    E_Prog[Программа]

    %% === Связи (Ромбы) ===
    R_Proizv{Производит}
    R_Isp{Использует}
    R_Ust{Установка}

    %% === Атрибуты сущностей ===
    A_Pr1((Наименование))
    A_Pr2((Страна))
    A_Pr3((Телефон))
    A_Pr4((Веб_сайт))

    A_PK1((Инвентарный_номер))
    A_PK2((Модель))
    A_PK3((Дата_приобретения))
    A_PK4((Характеристики))

    A_Pol1((ФИО))
    A_Pol2((Должность))
    A_Pol3((Табельный_номер))
    A_Pol4((Телефон))

    A_Prog1((Наименование))
    A_Prog2((Версия))
    A_Prog3((Разработчик))
    A_Prog4((Тип_лицензии))

    %% === Атрибуты связи М:М ===
    A_Ust1((Дата_установки))
    A_Ust2((Статус_активации))
    A_Ust3((Срок_действия))
    A_Ust4((Ответственный))

    %% === Связи Сущность-Атрибут ===
    E_Proizv --- A_Pr1 & A_Pr2 & A_Pr3 & A_Pr4
    E_PK --- A_PK1 & A_PK2 & A_PK3 & A_PK4
    E_Pol --- A_Pol1 & A_Pol2 & A_Pol3 & A_Pol4
    E_Prog --- A_Prog1 & A_Prog2 & A_Prog3 & A_Prog4
    R_Ust --- A_Ust1 & A_Ust2 & A_Ust3 & A_Ust4

    %% === Связи Сущность-Связь с кратностью ===
    E_Proizv -- 1 --- R_Proizv
    R_Proizv -- M --- E_PK

    E_Pol -- 1 --- R_Isp
    R_Isp -- M --- E_PK

    E_PK -- M --- R_Ust
    R_Ust -- N --- E_Prog
